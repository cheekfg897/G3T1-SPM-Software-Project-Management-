dth="133.3" height="116.7" as="geometry"/></mxCell><mxCell id="events" value="&lt;b style=&quot;font-size:12px&quot;&gt;events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[/api/events]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Event-request&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lifecycle: submit,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;assign, review,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;safety review, confirm.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The hub: calls most.&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;rounded=1;arcSize=10;fillColor=#85bbf0;strokeColor=#5b9bd5;fontColor=#0b1f33;" vertex="1" parent="1"><mxGeometry x="652.0" y="520.8" width="133.3" height="116.7" as="geometry"/></mxCell><mxCell id="notifications" value="&lt;b style=&quot;font-size:12px&quot;&gt;notifications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[/api/notifications]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Saved notification&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;records: list,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;unread count,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;mark read.&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;rounded=1;arcSize=10;fillColor=#85bbf0;strokeColor=#5b9bd5;fontColor=#0b1f33;" vertex="1" parent="1"><mxGeometry x="429.1" y="668.7" width="133.3" height="116.7" as="geometry"/></mxCell><mxCell id="kernel" value="&lt;b style=&quot;font-size:12px&quot;&gt;Shared kernel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[app/common]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Error shape · @requires_auth / @requires_role · marshmallow validation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&