<mxfile host="app.diagrams.net"><diagram id="contain" name="Container diagram: ConnectSphere"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1390" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="boundary" value="ConnectSphere  [Software system]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=20;spacingBottom=10;fontStyle=1;fontSize=19;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="800" height="1110" as="geometry"/></mxCell><mxCell id="organiser" value="&lt;b style=&quot;font-size:19px&quot;&gt;Event Organiser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Client representative who signs up themselves&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;shape=mxgraph.c4.person2;fillColor=#6c6477;strokeColor=#4d4d4d;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="550" y="80" width="260" height="200" as="geometry"/></mxCell><mxCell id="attendee" value="&lt;b style=&quot;font-size:19px&quot;&gt;Attendee&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Member of the public who signs up themselves&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;shape=mxgraph.c4.person2;fillColor=#6c6477;strokeColor=#4d4d4d;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="850" y="80" width="260" height="200" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b style=&quot;font-size:19px&quot;&gt;ConnectSphere staff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;The five staff roles, created by CLI command&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;shape=mxgraph.c4.person2;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1150" y="80" width="260" height="200" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:19px&quot;&gt;Web App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;[React, TypeScript, Vite, Tailwind CSS]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Single-page app that runs in the user&amp;#x27;s browser&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;rounded=1;arcSize=10;fillColor=#2f6db5;strokeColor=#1f4f86;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="520" width="720" height="110" as="geometry"/></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:19px&quot;&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;[Python 3.12, Flask 3.1]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Modular monolith: REST/JSON under /api. Login, role checks, validation and business rules&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;rounded=1;arcSize=10;fillColor=#2f6db5;strokeColor=#1f4f86;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="750" width="720" height="140" as="geometry"/></mxCell><mxCell id="database" value="&lt;b style=&quot;font-size:19px&quot;&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;[PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Users, organisations, events and history, venues, bookings, equipment, registrations, notifications&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#2f6db5;strokeColor=#1f4f86;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="810" y="1030" width="340" height="170" as="geometry"/></mxCell><mxCell id="job" value="&lt;b style=&quot;font-size:19px&quot;&gt;Hold-expiry job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;[Flask CLI: flask expire-holds]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Expires tentative holds and warns coordinators 24 hours before expiry. Run hourly by a GitHub Actions schedule; safe to re-run.&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;rounded=1;arcSize=10;fillColor=#2f6db5;strokeColor=#1f4f86;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="810" y="1320" width="340" height="170" as="geometry"/></mxCell><mxCell id="edge1" value="Submits requests,&lt;br&gt;answers clarifications&lt;br&gt;[HTTPS]" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.0833;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="organiser" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="Browses events,&lt;br&gt;registers, withdraws&lt;br&gt;[HTTPS]" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="attendee" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="Reviews, assigns and&lt;br&gt;arranges events&lt;br&gt;[HTTPS]" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.9167;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="staff" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="Calls&lt;br&gt;[JSON over HTTP, Bearer JWT]" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="Reads and writes&lt;br&gt;[SQLAlchemy, psycopg2]" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="database"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="Marks holds Expired,&lt;br&gt;writes history and&lt;br&gt;notifications&lt;br&gt;[SQLAlchemy, psycopg2]" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#707070;strokeWidth=1.5;fontColor=#333333;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="job" target="database"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="Container diagram: ConnectSphere" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="900" height="44" as="geometry"/></mxCell><mxCell id="swatch0" value="" style="rounded=1;fillColor=#6c6477;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1612" width="28" height="20" as="geometry"/></mxCell><mxCell id="legend0" value="External person" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="136" y="1610" width="146" height="24" as="geometry"/></mxCell><mxCell id="swatch1" value="" style="rounded=1;fillColor=#08427b;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="1612" width="28" height="20" as="geometry"/></mxCell><mxCell id="legend1" value="ConnectSphere 