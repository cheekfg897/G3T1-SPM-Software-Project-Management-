<mxfile host="app.diagrams.net"><diagram id="component" name="Component diagram: ConnectSphere Backend API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1170" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="group" value="From the&lt;br&gt;command line" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#f3f4f6;strokeColor=#9ca3af;dashed=1;dashPattern=4 3;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="4.2" y="485.4" width="120.8" height="162.5" as="geometry"/></mxCell><mxCell id="boundary" value="Backend API  [Container: Python 3.12, Flask 3.1]" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 6;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=16;spacingBottom=8;fontStyle=1;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="152.1" y="179.1" width="658.3" height="810.3" as="geometry"/></mxCell><mxCell id="job" value="&lt;b style=&quot;font-size:12px&quot;&gt;Hold-expiry job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Flask CLI:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;flask expire-holds]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Expires holds and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;warns coordinators&lt;/span&gt;" style="whiteSpace=wrap;html=1;align=center;metaEdit=1;rounded=1;arcSize=10;fillColor=#2f6db5;strokeColor=#1f4f86;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="10.4" y="529.1" width="108.3" height="104.2" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:12px&quot;&gt;Web App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[React, TypeScript, Vite,